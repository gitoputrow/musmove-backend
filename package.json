{
  "name": "musmove-backend",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev",
    "dev:vision": "node scripts/dev-with-vision.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "security:check": "tsx scripts/security-preflight.ts",
    "security:secrets": "node scripts/check-secrets.mjs",
    "accounts:deletions": "NODE_OPTIONS='--conditions=react-server' tsx scripts/process-account-deletions.ts",
    "social:moderate": "NODE_OPTIONS='--conditions=react-server' tsx scripts/moderate-social.ts",
    "catalogs:audit": "NODE_OPTIONS='--conditions=react-server' tsx scripts/audit-catalogs.ts",
    "test:follow-up": "NODE_OPTIONS='--conditions=react-server' tsx --test tests/api/follow-up.test.ts",
    "test:auth": "NODE_OPTIONS='--conditions=react-server' tsx --test tests/api/auth-proxy.test.ts",
    "test:security": "NODE_OPTIONS='--conditions=react-server' tsx --test tests/api/security.test.ts tests/db/migration-env.test.ts",
    "db:test-security": "NODE_OPTIONS='--conditions=react-server' tsx tests/api/security-integration.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:test-schema": "tsx tests/db/schema-smoke.ts",
    "db:test-api": "NODE_OPTIONS='--conditions=react-server' tsx tests/api/sync-integration.ts",
    "test:programs": "tsx --test tests/api/personalization.test.ts",
    "test:movement-tags": "tsx --test tests/api/movement-tags.test.ts",
    "db:test-movement-tags": "NODE_OPTIONS='--conditions=react-server' tsx tests/api/movement-tags-integration.ts",
    "test:nutrition": "tsx --test tests/api/nutrition.test.ts",
    "test:food-catalog": "tsx --test tests/api/food-catalog.test.ts",
    "test:food-prices": "NODE_OPTIONS='--conditions=react-server' tsx --test tests/api/food-prices.test.ts",
    "db:test-food-catalog": "NODE_OPTIONS='--conditions=react-server' tsx tests/api/food-catalog-integration.ts",
    "test:places": "tsx --test tests/api/places.test.ts",
    "test:equipment": "tsx --test tests/api/equipment.test.ts",
    "db:test-equipment": "NODE_OPTIONS='--conditions=react-server' tsx tests/api/equipment-integration.ts",
    "test:vision": "services/equipment-vision/.venv/bin/python -m unittest discover -s services/equipment-vision -p 'test_*.py'",
    "test:vision-real": "NODE_OPTIONS='--conditions=react-server' tsx tests/api/equipment-vision-smoke.ts",
    "db:test-places": "NODE_OPTIONS='--conditions=react-server' tsx tests/api/places-integration.ts",
    "test:nutrition-dart": "dart run tests/contracts/nutrition-dart-parity.dart",
    "db:test-nutrition": "NODE_OPTIONS='--conditions=react-server' tsx tests/api/nutrition-integration.ts",
    "db:backfill-nutrition": "NODE_OPTIONS='--conditions=react-server' tsx src/db/backfill-nutrition.ts"
  },
  "dependencies": {
    "@next/env": "^16.4.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^16",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
