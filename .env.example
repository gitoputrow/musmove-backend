# Pooled Neon connection used by the running Next.js API. Use a limited,
# non-owner runtime role in staging/production.
DATABASE_URL=postgresql://USER:PASSWORD@POOL_HOST/DATABASE?sslmode=verify-full

# For migrations only, put DATABASE_URL_DIRECT in .env.migrations.local instead
# of this runtime file. Migration tooling loads that ignored file explicitly;
# Next.js does not. Never upload migration credentials to Vercel.

# Keep this small per backend instance, then tune from load-test results.
DATABASE_POOL_MAX=5

# Enable only after community rules and trusted moderation tooling are ready.
SOCIAL_PUBLISHING_ENABLED=false
# Operational NEON_AUTH_ADMIN_COOKIE belongs in ignored .env.operations.local
# on a trusted worker machine, NEVER in this file or the Vercel API runtime.

# Server-only upstream. Mobile uses /api/v1/auth on the Next.js domain.
NEON_AUTH_BASE_URL=https://YOUR_AUTH_HOST/neondb/auth
# Exact HTTPS origin for server-owned auth callbacks; add it to Neon trusted domains.
# Defaults to the production origin below. Never derive it from request Host headers.
AUTH_PUBLIC_ORIGIN=https://musmove-backend.vercel.app

# Generate independent random values of at least 32 characters per environment.
# Required by auth proxy: encrypts native session envelopes; keep independent.
# Rotation invalidates native envelopes, not provider sessions; users sign in again.
# Do not expose it in Flutter/NEXT_PUBLIC_.
AUTH_SECRET=replace-with-at-least-32-random-characters
SYNC_CURSOR_SECRET=replace-with-a-different-32-character-secret
API_RATE_LIMIT_SECRET=replace-with-an-independent-random-32-character-secret

# Optional web origin for CORS. Native mobile requests normally have no Origin.
APP_ORIGIN=http://localhost:3000
# On Vercel: omit APP_ORIGIN for native-only mobile, or set your exact HTTPS web
# origin. Never deploy localhost origins, owner DB URLs or DATABASE_URL_DIRECT.

# Private self-hosted SigLIP 2 service. Not a public third-party photo endpoint.
# npm run dev:vision supplies these automatically using an ephemeral token.
EQUIPMENT_VISION_URL=http://127.0.0.1:8100
EQUIPMENT_VISION_TOKEN=replace-with-a-random-shared-secret-at-least-32-characters
EQUIPMENT_VISION_TIMEOUT_MS=30000
